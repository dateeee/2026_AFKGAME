<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.afkgame.domain.repository.PlayerSettingsMapper">

  <!-- toast_enabled はプロパティ名の自動変換（map-underscore-to-camel-case）と食い違うため、
       列とプロパティの対応を明示する -->
  <resultMap id="playerSettingsResultMap" type="com.afkgame.domain.model.PlayerSettings">
    <id     property="id"              column="id"/>
    <result property="playerId"        column="player_id"/>
    <result property="potionThreshold" column="potion_threshold"/>
    <result property="battleLogCount"  column="battle_log_count"/>
    <result property="toastEnabled"    column="toast_enabled"/>
    <result property="autoSellRarity"  column="auto_sell_rarity"/>
  </resultMap>

  <select id="selectByPlayerId" resultMap="playerSettingsResultMap">
    SELECT id, player_id, potion_threshold, battle_log_count, toast_enabled, auto_sell_rarity
      FROM player_settings
     WHERE player_id = #{playerId}
  </select>

  <insert id="insert">
    INSERT INTO player_settings (id, player_id, potion_threshold, battle_log_count,
                                 toast_enabled, auto_sell_rarity)
    VALUES (#{id}, #{playerId}, #{potionThreshold}, #{battleLogCount},
            #{toastEnabled}, #{autoSellRarity})
  </insert>

</mapper>
