<?xml version="1.0" encoding="UTF-8"?><project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.afkgame</groupId>
  <artifactId>afkgame</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <parent>
    <groupId>org.terasoluna.gfw</groupId>
    <artifactId>terasoluna-gfw-parent</artifactId>
    <version>5.11.0.RELEASE</version>
  </parent>
  <name>afkgame</name>
  <description>AFK GAME backend (TERASOLUNA Server Framework for Java 5.x / war)</description>
  <build>
    <finalName>${project.artifactId}</finalName>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <parameters>true</parameters>
            <annotationProcessorPaths>
              <path>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
              </path>
              <!-- REMOVE THIS LINE IF YOU USE MapStruct AND Lombok
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${lombok-mapstruct-binding.version}</version>
                            </path>
                            REMOVE THIS LINE IF YOU USE MapStruct AND Lombok -->
            </annotationProcessorPaths>
            <compilerArgs>
              <arg>-Amapstruct.defaultComponentModel=spring</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <!-- 雛形は integration-test ゴールしか持たない。verify が無いと
                     結合テストが失敗してもビルドが落ちない（2R-0 の確定結果） -->
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <executions>
            <execution>
              <id>add-source</id>
              <phase>generate-sources</phase>
              <goals>
                <goal>add-source</goal>
              </goals>
              <configuration>
                <sources>
                  <source>src/generated/java</source>
                </sources>
              </configuration>
            </execution>
            <execution>
              <id>add-resource</id>
              <phase>generate-resources</phase>
              <goals>
                <goal>add-resource</goal>
              </goals>
              <configuration>
                <resources>
                  <resource>
                    <directory>src/generated/resources</directory>
                  </resource>
                </resources>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-war-plugin</artifactId>
          <configuration>
            <archive>
              <addMavenDescriptor>false</addMavenDescriptor>
              <manifest>
                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
              </manifest>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <configuration>
            <source>${java-version}</source>
          </configuration>
        </plugin>
        <!-- 単体テストのC1（分岐）カバレッジ100%を mvn verify で判定する。版は親が管理する -->
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <executions>
            <execution>
              <id>prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>report</id>
              <phase>verify</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
            <execution>
              <id>check-branch-coverage</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
              <configuration>
                <rules>
                  <rule>
                    <element>BUNDLE</element>
                    <limits>
                      <limit>
                        <counter>BRANCH</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>1.00</minimum>
                      </limit>
                    </limits>
                  </rule>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- 単体テスト（mvn test）。@Tag("integration") を除外し、C1 100% の判定を単体テストだけで行う。
           絞り込み実行は mvn test -Dtest=<クラス>Test -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>integration</excludedGroups>
        </configuration>
      </plugin>

      <!-- 結合テスト（mvn verify の integration-test フェーズ）。@Tag("integration") のみを実行する。
           クラス名は *IntegrationTest / *RepositoryTest と単体テストで揃っているため、includes は
           failsafe 既定の *IT ではなく *Test とし、実際の選別は groups（JUnit 5 のタグ）で行う。
           verify ゴールは pluginManagement 側で足してある（無いと結合テストが失敗しても
           ビルドが落ちない。2R-0 の確定結果）。

           argLine を明示して JaCoCo の javaagent（prepare-agent が argLine へ前置する）を意図的に
           外している。結合テストの通過分をカバレッジへ混ぜないための措置で、これがないと
           jacoco.exec に結合テストの実行結果が追記され、単体テストの C1 を過大評価する -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <groups>integration</groups>
          <includes>
            <include>**/*Test.java</include>
          </includes>
          <argLine>-Dfile.encoding=UTF-8</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>afkgame-domain</artifactId>
        <version>0.1.0</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>afkgame-web</artifactId>
        <version>0.1.0</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>afkgame-env</artifactId>
        <version>0.1.0</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>afkgame-initdb</artifactId>
        <version>0.1.0</version>
      </dependency>
      <!-- == Begin Database == -->
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>
      <!-- == End Database == -->
      <!-- == Begin JWT ==
           jjwt は親（terasoluna-gfw-parent）が管理しないため版を自分で固定する。
           JSON シリアライザは jjwt-jackson（Jackson 2 databind を使う）を採る -->
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-api</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-impl</artifactId>
        <version>${jjwt.version}</version>
        <scope>runtime</scope>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-jackson</artifactId>
        <version>${jjwt.version}</version>
        <scope>runtime</scope>
      </dependency>
      <!-- == End JWT == -->
      <!-- == Begin Test ==
           親（terasoluna-gfw-parent）は junit-jupiter / mockito / spring-test の版だけを管理する。
           以下は管理外のため自分で固定する（移行 STEP 2R-E で Maven Central へ確認） -->
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>
      <!-- MockMvc の jsonPath() / header() マッチャが要る（spring-test では optional 依存） -->
      <dependency>
        <groupId>org.hamcrest</groupId>
        <artifactId>hamcrest</artifactId>
        <version>${hamcrest.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.jayway.jsonpath</groupId>
        <artifactId>json-path</artifactId>
        <version>${json-path.version}</version>
        <scope>test</scope>
      </dependency>
      <!-- 統合テスト用の埋め込み PostgreSQL。EmbeddedPostgres.builder().start() で直接起動する
           （Boot 前提の embedded-database-spring-test は使わない。2R-0 の確定結果） -->
      <dependency>
        <groupId>io.zonky.test</groupId>
        <artifactId>embedded-postgres</artifactId>
        <version>${embedded-postgres.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.zonky.test.postgres</groupId>
        <artifactId>embedded-postgres-binaries-bom</artifactId>
        <version>${embedded-postgres-binaries.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>afkgame-env</artifactId>
        <version>0.1.0</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <!-- == End Test == -->
    </dependencies>
  </dependencyManagement>
  <properties>
    <!-- == Dependency Versions == -->
    <postgresql.version>42.7.9</postgresql.version>
    <jjwt.version>0.12.6</jjwt.version>
    <assertj.version>3.27.3</assertj.version>
    <hamcrest.version>3.0</hamcrest.version>
    <json-path.version>2.9.0</json-path.version>
    <embedded-postgres.version>2.1.0</embedded-postgres.version>
    <!-- 埋め込み PostgreSQL のメジャーバージョン（docker-compose.yml と揃える） -->
    <embedded-postgres-binaries.version>16.9.0</embedded-postgres-binaries.version>
    <!-- == Project Properties == -->
    <encoding>UTF-8</encoding>
    <java-version>17</java-version>
    <!-- 実行環境の platform encoding が MS932 のため、テストJVMを UTF-8 に固定する。
         JaCoCo の prepare-agent は本プロパティへ javaagent 引数を前置する（2R-E で追加） -->
    <argLine>-Dfile.encoding=UTF-8</argLine>
  </properties>
  <!-- afkgame-selenium は作らない（E2E は Playwright を使う。tech_selection.md §2） -->
  <modules>
    <module>afkgame-env</module>
    <module>afkgame-domain</module>
    <module>afkgame-web</module>
    <module>afkgame-initdb</module>
  </modules>
</project>
