<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>afkgame-env</artifactId>
    <packaging>jar</packaging>
    <parent>
        <groupId>com.afkgame</groupId>
        <artifactId>afkgame</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <name>afkgame-env</name>
    <description>環境依存設定（META-INF/spring/*.properties・DataSource・logback.xml）</description>

    <!-- 雛形の local / test-server / production-server プロファイル（configs/<env>/resources の
         差し替え）は使わない。環境の切替は SPRING_PROFILES_ACTIVE、値の上書きは DATABASE_URL 等の
         環境変数で行う（2R-0 の確定結果。tech_operations.md §12.2） -->

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <configuration>
                    <encoding>${encoding}</encoding>
                </configuration>
            </plugin>
            <!-- テスト基盤（EmbeddedPostgresSupport）を afkgame-domain / afkgame-web の
                 統合テストへ配るため test-jar を作る。DataSource の供給元は本モジュールなので、
                 テスト用の差し替えも同じ場所に置く（移行 STEP 2R-E） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- DB は PostgreSQL に統一する（H2 は使わない。tech_selection.md §2） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway 本体（flyway-core / flyway-database-postgresql）と V1 の SQL を
             クラスパスへ載せる。起動時マイグレーションは AfkgameEnvConfig#flyway が実行する -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>afkgame-initdb</artifactId>
        </dependency>

        <!-- == Begin TERASOLUNA == -->
        <dependency>
            <groupId>org.terasoluna.gfw</groupId>
            <artifactId>terasoluna-gfw-common-dependencies</artifactId>
            <type>pom</type>
        </dependency>
        <!--  REMOVE THIS LINE IF YOU USE JPA
        <dependency>
            <groupId>org.terasoluna.gfw</groupId>
            <artifactId>terasoluna-gfw-jpa-dependencies</artifactId>
            <type>pom</type>
        </dependency>
              REMOVE THIS LINE IF YOU USE JPA  -->
        <dependency>
            <groupId>org.terasoluna.gfw</groupId>
            <artifactId>terasoluna-gfw-mybatis3-dependencies</artifactId>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>org.terasoluna.gfw</groupId>
            <artifactId>terasoluna-gfw-recommended-dependencies</artifactId>
            <type>pom</type>
        </dependency>
        <!-- == End TERASOLUNA == -->

        <!-- == Begin Unit Test == -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- test-jar が配る EmbeddedPostgresSupport が使う（統合テストの DB 起動） -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- == End Unit Test == -->
    </dependencies>
</project>
