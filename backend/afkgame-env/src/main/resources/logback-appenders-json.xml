<?xml version="1.0" encoding="UTF-8"?>
<!--
  本番用の構造化JSON形式（LOG_FORMAT=json）。docs/tech/basic/tech_logging.md「ログフォーマット」。
  3appender（COMMUNICATION / APPLICATION / ERROR_ALERT / CONSOLE）の定義は
  coding_standards_backend/logging.md §1・§1.1 が正。ファイルは日次ローテ・保持14日・gz圧縮。
  CONSOLE のみ ERROR 以下を落とす（二重肥大の抑制。logging.md §1）。

  項目名（timestamp / level / logger / message ＋ MDC の request_id・client_ip・method・path ほか、
  例外があれば exception）の組み立ては JsonLogFormatter が持つ。UTF-8 固定のため charset 設定は不要。
-->
<included>
    <property name="LOG_DIR" value="${LOG_DIR:-${catalina.base:-.}/logs}" />

    <appender name="COMMUNICATION" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/communication.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/communication.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>14</maxHistory>
        </rollingPolicy>
        <encoder class="com.afkgame.env.logging.JsonLogFormatter" />
    </appender>

    <appender name="APPLICATION" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/application.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>14</maxHistory>
        </rollingPolicy>
        <encoder class="com.afkgame.env.logging.JsonLogFormatter" />
    </appender>

    <appender name="ERROR_ALERT" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/error.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>14</maxHistory>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder class="com.afkgame.env.logging.JsonLogFormatter" />
    </appender>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder class="com.afkgame.env.logging.JsonLogFormatter" />
    </appender>
</included>

