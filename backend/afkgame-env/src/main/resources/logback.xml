<?xml version="1.0" encoding="UTF-8"?>
<!--
  ログ設定。仕様の正は docs/tech/basic/tech_logging.md（形式は「ログフォーマット」、
  ロガー名は「ロガー名体系」、環境変数は「設定値」）。appender・ロガー割り当ての正は
  coding_standards_backend/logging.md §1・§1.1。

  形式は LOG_FORMAT（text / json、既定 text）、レベルは LOG_LEVEL（既定 INFO）で切り替える。
  Spring Boot の <springProfile> は使えず、条件分岐タグ <if> は Janino を必要とするため、
  形式ごとの定義ファイルを include で読み分ける。
-->
<configuration>

    <include resource="logback-appenders-${LOG_FORMAT:-text}.xml" />

    <!-- 通信ログ。additivity=false のため ERROR_ALERT を明示的に紐づける（漏らすと監視から抜ける） -->
    <logger name="afkgame.comm" level="${LOG_LEVEL:-INFO}" additivity="false">
        <appender-ref ref="COMMUNICATION" />
        <appender-ref ref="ERROR_ALERT" />
        <appender-ref ref="CONSOLE" />
    </logger>

    <!-- Application Loggers -->
    <!-- 体系上のロガー（afkgame.auth 等）とクラス名ロガー（com.afkgame.*）を併用するため
         両方を LOG_LEVEL で制御する -->
    <logger name="afkgame" level="${LOG_LEVEL:-INFO}" />

    <logger name="com.afkgame" level="${LOG_LEVEL:-INFO}" />

    <!-- TERASOLUNA -->
    <logger name="org.terasoluna.gfw" level="info" />

    <logger name="org.terasoluna.gfw.common.exception.ExceptionLogger" level="info" />

    <!-- 3rdparty Loggers -->
    <logger name="org.springframework" level="warn" />

    <root level="warn">
        <appender-ref ref="APPLICATION" />
        <appender-ref ref="ERROR_ALERT" />
        <appender-ref ref="CONSOLE" />
    </root>

</configuration>
