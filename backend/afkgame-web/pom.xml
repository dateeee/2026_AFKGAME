<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>afkgame-web</artifactId>
    <packaging>war</packaging>
    <parent>
        <groupId>com.afkgame</groupId>
        <artifactId>afkgame</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <name>afkgame-web</name>
    <description>アプリケーション層（@RestController・Resource・設定）。war を作る</description>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- GET /health が返すバージョンを ${project.version} から埋める。war のマニフェストでは
                 なくリソースにするのは、war を作らない単体・結合テストでも同じ値を返すため
                 （2R-0 の確定結果。tech_operations.md §12.3） -->
            <resource>
                <directory>src/main/resources-filtered</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <configuration>
                    <encoding>${encoding}</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>
            <!-- 単体テストの C1（分岐）100% を mvn verify で判定する（設定は親の pluginManagement）。
                 加えて全モジュールを1つにまとめた HTML を backend/target/site/jacoco-aggregate へ出す
                 （モジュール別の target/site/jacoco は check の判定単位＝BUNDLE に対応するため残す）。

                 report-aggregate を web に置くのは、**依存をたどって全モジュールへ届く唯一のモジュール**
                 だから（集約対象は「自分が依存するモジュール」＝ domain・env。自分自身は
                 includeCurrentProject で含める）。reactor は env → domain → web の順に
                 ライフサイクルを回すので、web の集約時点で各モジュールの jacoco.exec は揃っている。

                 フェーズを verify ではなく post-integration-test にするのは、**check より先に出す**ため。
                 C1 が 100% に届かず check が落ちる場面こそ HTML を開きたいが、同じ verify に置くと
                 プラグイン間の実行順が保証されず、集約前に build が落ちうる -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <includeCurrentProject>true</includeCurrentProject>
                            <outputDirectory>${project.basedir}/../target/site/jacoco-aggregate</outputDirectory>
                            <title>AFK GAME backend (afkgame-env + afkgame-domain + afkgame-web)</title>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- 雛形の local / warpack / warpack-with-env プロファイルは使わない。
         環境の切替は SPRING_PROFILES_ACTIVE と DATABASE_URL 等の環境変数で行うため、
         afkgame-env は常に war へ同梱する（2R-0 の確定結果。tech_selection.md §2） -->

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>afkgame-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>afkgame-env</artifactId>
        </dependency>

        <!-- == Begin TERASOLUNA == -->
        <dependency>
