# カバレッジ計測設定（pytest.ini の --cov 系オプションと併用）
# HTMLレポート: backend/htmlcov/index.html（gitignore 済み）

[run]
source = app
branch = True
omit =
    app/__init__.py

[report]
precision = 1
show_missing = True
sort = Cover
exclude_also =
    if TYPE_CHECKING:
    raise NotImplementedError
    @(abc\.)?abstractmethod

[html]
directory = htmlcov
title = AFK GAME バックエンド C1カバレッジ
